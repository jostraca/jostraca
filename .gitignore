# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# next.js build output
.next

*~

tsconfig.tsbuildinfo

.jostraca
package-lock.json


# Performance run output. The baseline is committed; per-run results are
# machine-specific and are regenerated by `make perf`.
test/spec/perf/latest-*.tsv

# bump-go writes this beside jostraca.go and mv's it into place. It survives
# only if sed itself errors, which means the publish is broken anyway -- but
# an untracked stray next to a tracked file is exactly what a later `git add
# -A` sweeps up by accident.
go/jostraca.go.tmp

# Local agent settings. Nothing under .claude/ is repository content -- it is
# one machine's tool permissions, tracked by accident, and it carried local
# filesystem paths into a public repo.
.claude/

# Vale's downloaded style packages. `vale sync` fetches Google from the
# package registry into .vale/styles/Google/, which is third-party content
# with its own release cadence -- pinned in .vale.ini and CI, not vendored.
# The vocabularies under styles/config/ ARE ours and stay tracked.
.vale/styles/*
!.vale/styles/config/
